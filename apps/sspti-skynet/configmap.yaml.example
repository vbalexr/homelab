apiVersion: v1
kind: ConfigMap
metadata:
  name: sspti-skynet-env
data:
  # EVE Online ESI
  ESI_BASE_URL: "https://esi.evetech.net/latest"
  ESI_DEFAULT_REGION_ID: "10000002"

  # Application Settings
  LOG_LEVEL: "INFO"

  # Corporation Configuration
  corp.yaml: |
    corporation: "Example Corp"
    ticker: "EXCO"
    division_id: 12345
    regions:
      - region_id: 10000002
        name: "The Forge"
        station_ids:
          - 60003760
      - region_id: 10000043
        name: "Domain"
    divisions:
      logistics:
        discord_channel_id: 1234567890
        manager_role_id: 1234567890
