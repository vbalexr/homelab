apiVersion: v1
kind: Secret
metadata:
  name: sspti-skynet-secret
type: Opaque
stringData:
  # Discord Bot token
  DISCORD_TOKEN: "your_discord_bot_token_here"

  # Janice Appraisal API
  JANICE_API_KEY: "your_janice_api_key_here"
  JANICE_BASE_URL: "https://janice.e-351.com/api/rest/v2"

  # LLM Configuration
  OPENAI_API_KEY: "your_llm_api_key_here"
  OPENAI_BASE_URL: "http://host.docker.internal:11434/v1"
  OPENAI_MODEL: "llama3.1:8b-instruct"
  OPENAI_MAX_TOOL_HOPS: "5"
  OPENAI_MAX_REFINEMENT_HOPS: "1"

  # Database
  DATABASE_URL: "postgresql://skynet:skynet@postgres:5432/skynet"

  # EVE Online ESI
  ESI_USER_AGENT: "Skynet/0.1 (contact: your-email@example.com)"
