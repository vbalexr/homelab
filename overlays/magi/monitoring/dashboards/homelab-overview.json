{
  "uid": "homelab-overview",
  "title": "Homelab Overview",
  "tags": [
    "homelab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 9,
      "type": "stat",
      "title": "Packet errors",
      "description": "Receive plus transmit errors on nodes and routers.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(node_network_receive_errs_total{device!~\"lo.*|veth.*|lxc.*|cilium.*|dummy.*|sit.*|ip6tnl.*|tunl.*|teql.*|enc.*|pf.*\"}[1h]) + increase(node_network_transmit_errs_total{device!~\"lo.*|veth.*|lxc.*|cilium.*|dummy.*|sit.*|ip6tnl.*|tunl.*|teql.*|enc.*|pf.*\"}[1h])) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Packet drops",
      "description": "Receive plus transmit drops on nodes and routers.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(node_network_receive_drop_total{device!~\"lo.*|veth.*|lxc.*|cilium.*|dummy.*|sit.*|ip6tnl.*|tunl.*|teql.*|enc.*|pf.*\"}[1h]) + increase(node_network_transmit_drop_total{device!~\"lo.*|veth.*|lxc.*|cilium.*|dummy.*|sit.*|ip6tnl.*|tunl.*|teql.*|enc.*|pf.*\"}[1h])) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Failed scrapes",
      "description": "Scrapes in the last hour where a target did not answer.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(count_over_time((up{job=~\"routers|node-exporter|truenas-graphite-exporter\"} == 0)[1h:30s])) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU temperatures",
      "description": "Hottest CPU core per host.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (instance) (node_hwmon_temp_celsius{job=\"node-exporter\", chip=\"platform_coretemp_0\"}) * on(instance) group_left(nodename) node_uname_info{job=\"node-exporter\"}",
          "legendFormat": "{{nodename}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (instance) (node_cpu_temperature_celsius{job=\"routers\"})",
          "legendFormat": "{{instance}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(scale_truenas_cputemp_temperatures_cpu)",
          "legendFormat": "mausoleum",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Disk / NVMe temperatures",
      "description": "Hottest NVMe per node; hottest disk (any of the NAS's NVMes and HDDs) for TrueNAS. TrueNAS series appear once its reporting sends disktemp metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (instance) (node_hwmon_temp_celsius{job=\"node-exporter\", chip=~\"nvme_.*\"}) * on(instance) group_left(nodename) node_uname_info{job=\"node-exporter\"}",
          "legendFormat": "{{nodename}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max({__name__=~\"scale_truenas_disktemp.*\"})",
          "legendFormat": "mausoleum",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Devices with errors or drops",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (instance, device) (increase(node_network_receive_errs_total{device!~\"lo.*|veth.*|lxc.*|cilium.*|dummy.*|sit.*|ip6tnl.*|tunl.*|teql.*|enc.*|pf.*\"}[1h]) + increase(node_network_transmit_errs_total{device!~\"lo.*|veth.*|lxc.*|cilium.*|dummy.*|sit.*|ip6tnl.*|tunl.*|teql.*|enc.*|pf.*\"}[1h])) * on(instance) group_left(nodename) node_uname_info) > 0",
          "legendFormat": "errors",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (instance, device) (increase(node_network_receive_drop_total{device!~\"lo.*|veth.*|lxc.*|cilium.*|dummy.*|sit.*|ip6tnl.*|tunl.*|teql.*|enc.*|pf.*\"}[1h]) + increase(node_network_transmit_drop_total{device!~\"lo.*|veth.*|lxc.*|cilium.*|dummy.*|sit.*|ip6tnl.*|tunl.*|teql.*|enc.*|pf.*\"}[1h])) * on(instance) group_left(nodename) node_uname_info) > 0",
          "legendFormat": "drops",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "instance": true
            },
            "renameByName": {
              "Value #A": "errors",
              "Value #B": "drops",
              "nodename": "machine"
            },
            "indexByName": {
              "nodename": 0,
              "device": 1,
              "Value #A": 2,
              "Value #B": 3
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Routers: WANs",
      "description": "in + out per WAN: Metro (vlan 2) and Star (vlan 3) on victim and demiurg.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(label_replace(sum by (instance, device) (rate(node_network_receive_bytes_total{job=\"routers\", device=~\"vlan02|vlan03\"}[$__rate_interval]) + rate(node_network_transmit_bytes_total{job=\"routers\", device=~\"vlan02|vlan03\"}[$__rate_interval])) * 8, \"device\", \"Metro\", \"device\", \"vlan02\"), \"device\", \"Star\", \"device\", \"vlan03\")",
          "legendFormat": "{{instance}} {{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Routers: VLANs (without WANs)",
      "description": "in + out per router VLAN: LAB (10), HOME (15), IOT (20), CCTV (25), Management (500).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 11,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace(label_replace(label_replace(label_replace(label_replace(sum by (instance, device) (rate(node_network_receive_bytes_total{job=\"routers\", device=~\"vlan.*\", device!~\"vlan02|vlan03\"}[$__rate_interval]) + rate(node_network_transmit_bytes_total{job=\"routers\", device=~\"vlan.*\", device!~\"vlan02|vlan03\"}[$__rate_interval])) * 8, \"device\", \"LAB\", \"device\", \"vlan010\"), \"device\", \"HOME\", \"device\", \"vlan015\"), \"device\", \"IOT\", \"device\", \"vlan020\"), \"device\", \"CCTV\", \"device\", \"vlan025\"), \"device\", \"Management\", \"device\", \"vlan0500\")",
          "legendFormat": "{{instance}} {{device}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Bonds: nodes + mausoleum",
      "description": "in + out per machine, summed over its bond interfaces.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 11,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance) (rate(node_network_receive_bytes_total{job=\"node-exporter\", device=~\"bond.*\"}[$__rate_interval]) + rate(node_network_transmit_bytes_total{job=\"node-exporter\", device=~\"bond.*\"}[$__rate_interval])) * 8 * on(instance) group_left(nodename) node_uname_info{job=\"node-exporter\"}",
          "legendFormat": "{{nodename}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(scale_truenas_net_bond1_received + abs(scale_truenas_net_bond1_sent)) * 1000",
          "legendFormat": "mausoleum",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Nodes: SFP+ ports",
      "description": "eno1-eno4 (X553 SFP+ ports): in + out, summed over both ports, per node.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance) (rate(node_network_receive_bytes_total{job=\"node-exporter\", device=~\"eno.*\"}[$__rate_interval]) + rate(node_network_transmit_bytes_total{job=\"node-exporter\", device=~\"eno.*\"}[$__rate_interval])) * 8 * on(instance) group_left(nodename) node_uname_info{job=\"node-exporter\"}",
          "legendFormat": "{{nodename}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Errors and drops over time",
      "description": "Per 5 minutes; empty means clean.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance, device) (increase(node_network_receive_errs_total{device!~\"lo.*|veth.*|lxc.*|cilium.*|dummy.*|sit.*|ip6tnl.*|tunl.*|teql.*|enc.*|pf.*\"}[5m]) + increase(node_network_transmit_errs_total{device!~\"lo.*|veth.*|lxc.*|cilium.*|dummy.*|sit.*|ip6tnl.*|tunl.*|teql.*|enc.*|pf.*\"}[5m])) * on(instance) group_left(nodename) node_uname_info > 0",
          "legendFormat": "{{nodename}} {{device}} errors",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance, device) (increase(node_network_receive_drop_total{device!~\"lo.*|veth.*|lxc.*|cilium.*|dummy.*|sit.*|ip6tnl.*|tunl.*|teql.*|enc.*|pf.*\"}[5m]) + increase(node_network_transmit_drop_total{device!~\"lo.*|veth.*|lxc.*|cilium.*|dummy.*|sit.*|ip6tnl.*|tunl.*|teql.*|enc.*|pf.*\"}[5m])) * on(instance) group_left(nodename) node_uname_info > 0",
          "legendFormat": "{{nodename}} {{device}} drops",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(scale_truenas_net_drops_bond1_inbound[5m]) + increase(scale_truenas_net_drops_bond1_outbound[5m]) > 0",
          "legendFormat": "mausoleum bond1 drops",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
