{
  "uid": "homelab-overview",
  "title": "Homelab Overview",
  "tags": [
    "homelab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 2,
      "type": "timeseries",
      "title": "Temperatures",
      "description": "Hottest CPU core per host, hottest NVMe per node.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (instance) (node_hwmon_temp_celsius{job=\"node-exporter\", chip=\"platform_coretemp_0\"}) * on(instance) group_left(nodename) node_uname_info{job=\"node-exporter\"}",
          "legendFormat": "{{nodename}} cpu",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (instance) (node_hwmon_temp_celsius{job=\"node-exporter\", chip=~\"nvme_.*\"}) * on(instance) group_left(nodename) node_uname_info{job=\"node-exporter\"}",
          "legendFormat": "{{nodename}} nvme",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (instance) (node_cpu_temperature_celsius{job=\"routers\"})",
          "legendFormat": "{{instance}} cpu",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(scale_truenas_cputemp_temperatures_cpu)",
          "legendFormat": "truenas cpu",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Nodes: bond",
      "description": "Links under 1 kbit/s are hidden.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (instance, device) (rate(node_network_receive_bytes_total{job=\"node-exporter\", device=~\"bond.*\"}[$__rate_interval])) * 8 > 1000) * on(instance) group_left(nodename) node_uname_info{job=\"node-exporter\"}",
          "legendFormat": "{{nodename}} {{device}} in",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (instance, device) (rate(node_network_transmit_bytes_total{job=\"node-exporter\", device=~\"bond.*\"}[$__rate_interval])) * 8 > 1000) * on(instance) group_left(nodename) node_uname_info{job=\"node-exporter\"}",
          "legendFormat": "{{nodename}} {{device}} out",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Routers: VLANs (without WANs)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance, device) (rate(node_network_receive_bytes_total{job=\"routers\", device=~\"vlan.*\", device!~\"vlan02|vlan03\"}[$__rate_interval])) * 8",
          "legendFormat": "{{instance}} {{device}} in",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance, device) (rate(node_network_transmit_bytes_total{job=\"routers\", device=~\"vlan.*\", device!~\"vlan02|vlan03\"}[$__rate_interval])) * 8",
          "legendFormat": "{{instance}} {{device}} out",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "TrueNAS: bond",
      "description": "TrueNAS reports kilobits per second, with transmit stored as a negative number; shown here as positive.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "scale_truenas_net_bond1_received * 1000",
          "legendFormat": "bond1 in",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "abs(scale_truenas_net_bond1_sent) * 1000",
          "legendFormat": "bond1 out",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Routers: WANs",
      "description": "vlan02 and vlan03 on Victim and Demiurg. ",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance, device) (rate(node_network_receive_bytes_total{job=\"routers\", device=~\"vlan02|vlan03\"}[$__rate_interval])) * 8",
          "legendFormat": "{{instance}} {{device}} in",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance, device) (rate(node_network_transmit_bytes_total{job=\"routers\", device=~\"vlan02|vlan03\"}[$__rate_interval])) * 8",
          "legendFormat": "{{instance}} {{device}} out",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Nodes: SFP+ ports",
      "description": "eno1-eno4, the X553 SFP+ ports. Links under 1 kbit/s are hidden.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (instance, device) (rate(node_network_receive_bytes_total{job=\"node-exporter\", device=~\"eno.*\"}[$__rate_interval])) * 8 > 1000) * on(instance) group_left(nodename) node_uname_info{job=\"node-exporter\"}",
          "legendFormat": "{{nodename}} {{device}} in",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (instance, device) (rate(node_network_transmit_bytes_total{job=\"node-exporter\", device=~\"eno.*\"}[$__rate_interval])) * 8 > 1000) * on(instance) group_left(nodename) node_uname_info{job=\"node-exporter\"}",
          "legendFormat": "{{nodename}} {{device}} out",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Packet errors",
      "description": "Receive plus transmit errors on nodes and routers.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(node_network_receive_errs_total{device!~\"lo.*|veth.*|lxc.*|cilium.*|dummy.*|sit.*|ip6tnl.*|tunl.*|teql.*|enc.*|pf.*\"}[1h]) + increase(node_network_transmit_errs_total{device!~\"lo.*|veth.*|lxc.*|cilium.*|dummy.*|sit.*|ip6tnl.*|tunl.*|teql.*|enc.*|pf.*\"}[1h])) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Packet drops",
      "description": "Receive plus transmit drops on nodes and routers.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(node_network_receive_drop_total{device!~\"lo.*|veth.*|lxc.*|cilium.*|dummy.*|sit.*|ip6tnl.*|tunl.*|teql.*|enc.*|pf.*\"}[1h]) + increase(node_network_transmit_drop_total{device!~\"lo.*|veth.*|lxc.*|cilium.*|dummy.*|sit.*|ip6tnl.*|tunl.*|teql.*|enc.*|pf.*\"}[1h])) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Failed scrapes",
      "description": "Scrapes in the last hour where a target did not answer.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(count_over_time((up{job=~\"routers|node-exporter|truenas-graphite-exporter\"} == 0)[1h:30s])) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Devices with errors or drops",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (instance, device) (increase(node_network_receive_errs_total{device!~\"lo.*|veth.*|lxc.*|cilium.*|dummy.*|sit.*|ip6tnl.*|tunl.*|teql.*|enc.*|pf.*\"}[1h]) + increase(node_network_transmit_errs_total{device!~\"lo.*|veth.*|lxc.*|cilium.*|dummy.*|sit.*|ip6tnl.*|tunl.*|teql.*|enc.*|pf.*\"}[1h]))) > 0",
          "legendFormat": "errors",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (instance, device) (increase(node_network_receive_drop_total{device!~\"lo.*|veth.*|lxc.*|cilium.*|dummy.*|sit.*|ip6tnl.*|tunl.*|teql.*|enc.*|pf.*\"}[1h]) + increase(node_network_transmit_drop_total{device!~\"lo.*|veth.*|lxc.*|cilium.*|dummy.*|sit.*|ip6tnl.*|tunl.*|teql.*|enc.*|pf.*\"}[1h]))) > 0",
          "legendFormat": "drops",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "errors",
              "Value #B": "drops"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Errors and drops over time",
      "description": "Per 5 minutes; empty means clean.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance, device) (increase(node_network_receive_errs_total{device!~\"lo.*|veth.*|lxc.*|cilium.*|dummy.*|sit.*|ip6tnl.*|tunl.*|teql.*|enc.*|pf.*\"}[5m]) + increase(node_network_transmit_errs_total{device!~\"lo.*|veth.*|lxc.*|cilium.*|dummy.*|sit.*|ip6tnl.*|tunl.*|teql.*|enc.*|pf.*\"}[5m])) > 0",
          "legendFormat": "{{instance}} {{device}} errors",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (instance, device) (increase(node_network_receive_drop_total{device!~\"lo.*|veth.*|lxc.*|cilium.*|dummy.*|sit.*|ip6tnl.*|tunl.*|teql.*|enc.*|pf.*\"}[5m]) + increase(node_network_transmit_drop_total{device!~\"lo.*|veth.*|lxc.*|cilium.*|dummy.*|sit.*|ip6tnl.*|tunl.*|teql.*|enc.*|pf.*\"}[5m])) > 0",
          "legendFormat": "{{instance}} {{device}} drops",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(scale_truenas_net_drops_bond1_inbound[5m]) + increase(scale_truenas_net_drops_bond1_outbound[5m]) > 0",
          "legendFormat": "truenas bond1 drops",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
